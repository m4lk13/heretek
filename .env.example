# Heretek environment variables — copy to .env and fill in the secrets.
# .env is gitignored (see .gitignore); .env.example is committed as the exemplar.
# See CLAUDE.md §8 for the full env-var contract.

# --- Telegram (Phase 4 required) ---
TELEGRAM_BOT_TOKEN=
HERETEK_OWNER_USER_ID=
HERETEK_OWNER_HANDLE=my Tech-Priest

# --- Local LLM (Phase 1 — already wired) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.6:35b-a3b-q4_K_M
OLLAMA_MODEL_LIGHT=qwen3:4b

# --- Heretek runtime ---
HERETEK_DATA_ROOT=
HERETEK_PLAYGROUND_BRANCH=playground
HERETEK_PROTECTED_BRANCHES=main,last-known-good
HERETEK_DRY_RUN_DEFAULT=true
HERETEK_BG_BUDGET_PCT=0
HERETEK_MAX_CONTEXT_TOKENS=32000
HERETEK_MAX_WORKERS=2

# --- Optional: GitHub (only for fork operations, not self-modify pushes) ---
GITHUB_USER=
GITHUB_REPO=heretek
GITHUB_TOKEN=

# --- Test-only / dev seam (production leaves this unset) ---
# HERETEK_EVOLVE_TEST_DIFF=
